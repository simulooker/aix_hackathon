# EAS builds only the Expo mobile application from this monorepo.
.git/
.github/
.expo/
node_modules/

# Backend, datasets, training scripts, and local artifacts are not part of APK builds.
services/
datasets/
scripts/
docs/
supabase/
tmp/
app/

