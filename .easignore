/.pytest_cache
/.pytest_cache/**
/services/api/.pytest_cache
/services/api/.pytest_cache/**
**/.pytest_cache/
**/__pycache__/
**/.expo/
**/node_modules/
**/dist/
**/tmp/
**/*.pt
**/*.pth
**/*.zip
**/*.log
**/.env

