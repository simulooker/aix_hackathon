{
  "expo": {
    "name": "위드유",
    "slug": "withyou",
    "version": "1.1.0",
    "description": "AI 위험 분석과 이용자 맞춤형 안전 보행 경로를 제공하는 위드유 앱",
    "orientation": "portrait",
    "icon": "./assets/images/ai-safe-route-logo-v4.png",
    "scheme": "aisafeway",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.simulooker.aisaferoute",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "현재 위치와 안전한 보행 경로를 안내하기 위해 위치를 사용합니다.",
        "NSCameraUsageDescription": "보행 위험 요소를 촬영하여 신고하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "위험 요소 신고 사진을 선택하기 위해 사진 보관함을 사용합니다."
      }
    },
    "android": {
      "package": "com.simulooker.aisaferoute",
      "adaptiveIcon": {
        "backgroundColor": "#DDF1E8",
        "foregroundImage": "./assets/images/ai-safe-route-logo-v4.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ai-safe-route-logo-v4.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치와 안전한 보행 경로를 안내하기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "위험 요소 신고 사진을 선택하기 위해 사진 보관함을 사용합니다.",
          "cameraPermission": "보행 위험 요소를 촬영하여 신고하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ai-safe-route-logo-v4.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#DDF1E8",
          "dark": {
            "backgroundColor": "#DDF1E8"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a840ca99-6f78-4a97-9157-c266ea880c16"
      }
    },
    "owner": "simulookers-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a840ca99-6f78-4a97-9157-c266ea880c16"
    }
  }
}
