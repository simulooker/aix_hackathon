ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORT_BUCKET=hazard-reports
DATABASE_URL=sqlite:///./local.db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SURFACE_MODEL_PATH=models/surface-seg-best.pt
OBSTACLE_MODEL_PATH=models/obstacle-detect-best.pt
AI_DEVICE=cpu
ORS_API_KEY=
DISASTER_API_URL=
DISASTER_API_KEY=
# 실제 재난 발생을 기다릴 수 없을 때만 사용하는 시연용 고정 데이터.
# 값이 있으면 위 API 대신 이 파일을 재난 피드로 사용한다. 평시에는 비워 둘 것.
DISASTER_DEMO_FILE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
